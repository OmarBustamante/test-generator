# Terraform state — may contain secrets, never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Local provider plugins and modules (re-downloaded by `terraform init`)
.terraform/
.terraform.lock.hcl

# Variable files that may hold sensitive values
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Generated Lambda package
lambda_package.zip

# Private operational runbook — not for the public repo
RUNBOOK.md
